{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Govee livery scheme",
 "type": "object",
 "required": [
  "slug",
  "name",
  "contrail",
  "primary",
  "steps"
 ],
 "$defs": {
  "rgb": {
   "type": "object",
   "required": [
    "r",
    "g",
    "b"
   ],
   "properties": {
    "r": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    },
    "g": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    },
    "b": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    }
   }
  },
  "brightness": {
   "type": "integer",
   "minimum": 1,
   "maximum": 100
  }
 },
 "properties": {
  "slug": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "registration": {
   "type": [
    "string",
    "null"
   ]
  },
  "group": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "contrail": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^#[0-9a-f]{6}$"
   }
  },
  "primary": {
   "type": "object",
   "required": [
    "color",
    "brightness"
   ],
   "properties": {
    "color": {
     "$ref": "#/$defs/rgb"
    },
    "source_hex": {
     "type": "string"
    },
    "brightness": {
     "$ref": "#/$defs/brightness"
    }
   }
  },
  "loop": {
   "type": "boolean"
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "color",
     "brightness",
     "holdMs"
    ],
    "properties": {
     "color": {
      "$ref": "#/$defs/rgb",
      "description": "LED-tuned rgb sent to the strip (H618C exaggerates green; see README)"
     },
     "source_hex": {
      "type": "string",
      "description": "Original game hex from jaysplanes liveries.ts, reference only"
     },
     "brightness": {
      "$ref": "#/$defs/brightness"
     },
     "holdMs": {
      "type": "integer",
      "minimum": 0
     },
     "pulse": {
      "type": "object",
      "required": [
       "type",
       "toBrightness",
       "periodMs",
       "count"
      ],
      "properties": {
       "type": {
        "const": "breathe"
       },
       "toBrightness": {
        "$ref": "#/$defs/brightness"
       },
       "periodMs": {
        "type": "integer"
       },
       "count": {
        "type": "integer"
       }
      }
     },
     "strobe": {
      "type": "object",
      "required": [
       "count",
       "onMs",
       "offMs"
      ],
      "properties": {
       "count": {
        "type": "integer"
       },
       "onMs": {
        "type": "integer",
        "minimum": 250
       },
       "offMs": {
        "type": "integer",
        "minimum": 250
       }
      }
     }
    }
   }
  },
  "contrail_led": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/rgb"
   },
   "description": "LED-tuned contrail colors"
  },
  "stripes": {
   "type": "object",
   "required": [
    "segment_count",
    "colors"
   ],
   "description": "Per-segment striped pattern via ptReal; colors repeat c1,c2,... across segments",
   "properties": {
    "segment_count": {
     "type": "integer",
     "minimum": 1,
     "maximum": 16,
     "description": "Assumed 15 (unconfirmed)"
    },
    "colors": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/rgb"
     }
    },
    "source_hex": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "gap_ms": {
     "type": "integer",
     "minimum": 0,
     "description": "Delay between ptReal packets"
    }
   }
  }
 }
}